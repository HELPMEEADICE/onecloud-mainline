# OneCloud (Amlogic S805 / Meson8b) kernel configuration fragment
# Applied on top of arch/arm/configs/multi_v7_defconfig.
# Boot-critical drivers are built in; optional peripherals are modules.

# --- Platform ---
CONFIG_ARCH_MESON=y
CONFIG_MACH_MESON8=y
CONFIG_SMP=y
CONFIG_ARM_CPU_TOPOLOGY=y
CONFIG_HAVE_ARM_SCU=y

# --- Clocks / pinctrl / power ---
CONFIG_COMMON_CLK_MESON8B=y
CONFIG_PINCTRL_MESON8B=y
CONFIG_PINCTRL_MESON8=y
CONFIG_MESON_MX_SOCINFO=y
CONFIG_NVMEM_MESON_MX_EFUSE=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y

# --- Serial console (ttyAML0) ---
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Storage: eMMC (sdhc) and SD card (sdio) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_MX_SDHC=y
CONFIG_MMC_MESON_MX_SDIO=y
CONFIG_MMC_SDIO=y
CONFIG_MMC_SDHCI=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- Ethernet: DesignWare MAC + RTL8211F PHY ---
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_MESON=y
CONFIG_DWMAC_GENERIC=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_MDIO_BUS=y
CONFIG_MDIO_DEVICE=y
CONFIG_FIXED_PHY=y

# --- USB ---
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=m
CONFIG_USB_PHY=y
CONFIG_PHY_MESON8B_USB2=y
CONFIG_NOP_USB_XCEIV=y

# --- Regulators / PWM (CPU core voltage) ---
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_PWM=y
CONFIG_PWM=y
CONFIG_PWM_MESON=y
CONFIG_PWM_SYSFS=y

# --- CPU frequency / thermal ---
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_OF=y

# --- Mali-450 3D GPU (lima DRM driver) ---
CONFIG_DRM=y
CONFIG_DRM_LIMA=m

# --- RTC / watchdog / ADC / IR ---
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MESON=y
CONFIG_WATCHDOG=y
CONFIG_MESON_WATCHDOG=y
CONFIG_MESON_SARADC=m
CONFIG_RC_CORE=m
CONFIG_IIO=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_IR_MESON=m

# --- Standard ARM32 userspace ABI ---
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_ARM_THUMB=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y

# --- Kernel identity ---
CONFIG_LOCALVERSION="-onecloud"
CONFIG_DEFAULT_HOSTNAME="onecloud"

# --- Reduce image size / avoid debug-only bloat ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_KALLSYMS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS_XZ=y
CONFIG_MODULE_DECOMPRESS=y

# --- systemd / containers friendly basics ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_TUN=y
CONFIG_OVERLAY_FS=y
