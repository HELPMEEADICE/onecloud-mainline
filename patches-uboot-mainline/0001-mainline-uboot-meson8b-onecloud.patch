diff --git a/drivers/mmc/meson_mx_sdio.c b/drivers/mmc/meson_mx_sdio.c
new file mode 100644
index 00000000..4f4d18aa
--- /dev/null
+++ b/drivers/mmc/meson_mx_sdio.c
@@ -0,0 +1,417 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic Meson6/8/8b SDIO/MMC controller driver for U-Boot.
+ *
+ * The register layout and command encoding are taken from the Linux
+ * meson-mx-sdio driver (Martin Blumenstingl) and from the vendor U-Boot
+ * aml_sd_mmc driver.  The controller is used for the eMMC (port C) and the
+ * SD card (port B) on the Xunlei OneCloud.
+ */
+
+#include <cpu_func.h>
+#include <dm.h>
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <time.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <memalign.h>
+#include <mmc.h>
+#include <part.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+
+#define MESON_MX_SDIO_ARGU		0x00
+#define MESON_MX_SDIO_SEND		0x04
+#define MESON_MX_SDIO_SEND_CMD_INDEX		GENMASK(7, 0)
+#define MESON_MX_SDIO_SEND_RESP_BITS		GENMASK(15, 8)
+#define MESON_MX_SDIO_SEND_RESP_WITHOUT_CRC7	BIT(16)
+#define MESON_MX_SDIO_SEND_RESP_HAS_DATA	BIT(17)
+#define MESON_MX_SDIO_SEND_RESP_CRC7_FROM_8	BIT(18)
+#define MESON_MX_SDIO_SEND_CHECK_DAT0_BUSY	BIT(19)
+#define MESON_MX_SDIO_SEND_DATA			BIT(20)
+#define MESON_MX_SDIO_SEND_REPEAT_PACKAGE	GENMASK(31, 24)
+
+#define MESON_MX_SDIO_CONF		0x08
+#define MESON_MX_SDIO_CONF_CLK_DIV		GENMASK(9, 0)
+#define MESON_MX_SDIO_CONF_DISABLE_CRC		BIT(10)
+#define MESON_MX_SDIO_CONF_CMD_POSEDGE		BIT(11)
+#define MESON_MX_SDIO_CONF_ARGUMENT_BITS	GENMASK(17, 12)
+#define MESON_MX_SDIO_CONF_RESP_NEGEDGE		BIT(18)
+#define MESON_MX_SDIO_CONF_DATA_NEGEDGE		BIT(19)
+#define MESON_MX_SDIO_CONF_BUS_WIDTH		BIT(20)
+#define MESON_MX_SDIO_CONF_M_ENDIAN		GENMASK(22, 21)
+#define MESON_MX_SDIO_CONF_WRITE_NWR		GENMASK(28, 23)
+#define MESON_MX_SDIO_CONF_WRITE_CRC_OK		GENMASK(31, 29)
+
+#define MESON_MX_SDIO_IRQS		0x0c
+#define MESON_MX_SDIO_IRQS_CMD_BUSY		BIT(4)
+#define MESON_MX_SDIO_IRQS_RESP_CRC7_OK		BIT(5)
+#define MESON_MX_SDIO_IRQS_READ_CRC16_OK	BIT(6)
+#define MESON_MX_SDIO_IRQS_WRITE_CRC16_OK	BIT(7)
+#define MESON_MX_SDIO_IRQS_IF_INT		BIT(8)
+#define MESON_MX_SDIO_IRQS_CMD_INT		BIT(9)
+#define MESON_MX_SDIO_IRQS_TIMING_OUT		BIT(16)
+
+#define MESON_MX_SDIO_IRQC		0x10
+#define MESON_MX_SDIO_IRQC_CMD_INT_EN		BIT(4)
+#define MESON_MX_SDIO_IRQC_SOFT_RESET		BIT(15)
+
+#define MESON_MX_SDIO_MULT		0x14
+#define MESON_MX_SDIO_MULT_PORT_SEL		GENMASK(1, 0)
+#define MESON_MX_SDIO_MULT_WR_RD_OUT_INDEX	BIT(8)
+#define MESON_MX_SDIO_MULT_RESP_READ_INDEX	GENMASK(15, 12)
+
+#define MESON_MX_SDIO_ADDR		0x18
+#define MESON_MX_SDIO_EXT		0x1c
+#define MESON_MX_SDIO_EXT_DATA_RW_NUMBER	GENMASK(29, 16)
+
+#define MESON_MX_SDIO_RESPONSE_CRC16_BITS	(16 - 1)
+#define MESON_MX_SDIO_TIMEOUT_MS		1000
+
+/* Clock measurement registers (CBUS). */
+#define MESON_MSR_CLK_REG0		((void __iomem *)0xc110875c)
+#define MESON_MSR_CLK_REG2		((void __iomem *)0xc1108764)
+#define MESON_CLK81_MSR_MUX		7
+#define MESON_CLK81_DEFAULT_RATE	166666666
+
+struct meson_mx_sdio_plat {
+	struct mmc mmc;
+	struct mmc_config cfg;
+};
+
+struct meson_mx_sdio_priv {
+	u32 base;
+	u32 port;
+	u32 clock;
+	u32 clk81_rate;
+	u8 *bounce;
+};
+
+static inline u32 meson_sdio_read(struct meson_mx_sdio_priv *priv, u32 reg)
+{
+	return readl((void __iomem *)(priv->base + reg));
+}
+
+static inline void meson_sdio_write(struct meson_mx_sdio_priv *priv, u32 reg,
+				    u32 val)
+{
+	writel(val, (void __iomem *)(priv->base + reg));
+}
+
+static u32 meson_clk81_rate(void)
+{
+	u32 msr;
+	int i;
+
+	writel(0, MESON_MSR_CLK_REG0);
+	clrsetbits_le32(MESON_MSR_CLK_REG0, 0xffff, 63);
+	clrbits_le32(MESON_MSR_CLK_REG0, BIT(18) | BIT(17));
+	clrsetbits_le32(MESON_MSR_CLK_REG0, GENMASK(23, 20),
+			(MESON_CLK81_MSR_MUX << 20) | BIT(19) | BIT(16));
+
+	readl(MESON_MSR_CLK_REG0);
+	for (i = 0; i < 100000; i++) {
+		if (!(readl(MESON_MSR_CLK_REG0) & BIT(31)))
+			break;
+	}
+	clrbits_le32(MESON_MSR_CLK_REG0, BIT(16));
+
+	if (i == 100000)
+		return MESON_CLK81_DEFAULT_RATE;
+
+	msr = (readl(MESON_MSR_CLK_REG2) + 31) & GENMASK(19, 0);
+
+	if (!msr || (msr >> 6) > 500)
+		return MESON_CLK81_DEFAULT_RATE;
+
+	return (msr >> 6) * 1000000;
+}
+
+static void meson_mx_sdio_reset(struct meson_mx_sdio_priv *priv)
+{
+	meson_sdio_write(priv, MESON_MX_SDIO_IRQC,
+			 MESON_MX_SDIO_IRQC_SOFT_RESET);
+	udelay(2);
+	meson_sdio_write(priv, MESON_MX_SDIO_IRQC,
+			 MESON_MX_SDIO_IRQC_CMD_INT_EN);
+}
+
+static void meson_mx_sdio_set_clock(struct meson_mx_sdio_priv *priv,
+				    uint clock)
+{
+	u32 conf, div;
+
+	if (!clock)
+		return;
+
+	div = priv->clk81_rate / (2 * clock);
+	if (div > MESON_MX_SDIO_CONF_CLK_DIV)
+		div = MESON_MX_SDIO_CONF_CLK_DIV;
+
+	conf = meson_sdio_read(priv, MESON_MX_SDIO_CONF);
+	conf &= ~MESON_MX_SDIO_CONF_CLK_DIV;
+	conf |= div;
+
+	priv->clock = clock;
+	meson_sdio_write(priv, MESON_MX_SDIO_CONF, conf);
+}
+
+static int meson_mx_sdio_set_ios(struct udevice *dev)
+{
+	struct meson_mx_sdio_priv *priv = dev_get_priv(dev);
+	struct mmc *mmc = mmc_get_mmc_dev(dev);
+	u32 conf;
+
+	meson_mx_sdio_set_clock(priv, mmc->clock);
+
+	conf = meson_sdio_read(priv, MESON_MX_SDIO_CONF);
+	conf &= ~(MESON_MX_SDIO_CONF_BUS_WIDTH |
+		  MESON_MX_SDIO_CONF_ARGUMENT_BITS |
+		  MESON_MX_SDIO_CONF_M_ENDIAN |
+		  MESON_MX_SDIO_CONF_WRITE_NWR |
+		  MESON_MX_SDIO_CONF_WRITE_CRC_OK);
+
+	/* Match the vendor U-Boot controller setup. */
+	conf |= FIELD_PREP(MESON_MX_SDIO_CONF_WRITE_CRC_OK, 2) |
+		FIELD_PREP(MESON_MX_SDIO_CONF_WRITE_NWR, 2) |
+		FIELD_PREP(MESON_MX_SDIO_CONF_M_ENDIAN, 3) |
+		FIELD_PREP(MESON_MX_SDIO_CONF_ARGUMENT_BITS, 39);
+
+	if (mmc->bus_width == 4)
+		conf |= MESON_MX_SDIO_CONF_BUS_WIDTH;
+
+	meson_sdio_write(priv, MESON_MX_SDIO_CONF, conf);
+
+	clrsetbits_le32((void __iomem *)(priv->base + MESON_MX_SDIO_MULT),
+			MESON_MX_SDIO_MULT_PORT_SEL,
+			priv->port & MESON_MX_SDIO_MULT_PORT_SEL);
+
+	return 0;
+}
+
+static void meson_mx_sdio_read_response(struct meson_mx_sdio_priv *priv,
+					struct mmc_cmd *cmd)
+{
+	u32 resp[4];
+	int i;
+
+	if (cmd->resp_type & MMC_RSP_136) {
+		clrsetbits_le32((void __iomem *)(priv->base + MESON_MX_SDIO_MULT),
+				MESON_MX_SDIO_MULT_WR_RD_OUT_INDEX |
+				MESON_MX_SDIO_MULT_RESP_READ_INDEX,
+				MESON_MX_SDIO_MULT_WR_RD_OUT_INDEX);
+
+		for (i = 0; i < 4; i++)
+			resp[3 - i] = meson_sdio_read(priv, MESON_MX_SDIO_ARGU);
+
+		cmd->response[0] = (resp[0] << 8) | ((resp[1] >> 24) & 0xff);
+		cmd->response[1] = (resp[1] << 8) | ((resp[2] >> 24) & 0xff);
+		cmd->response[2] = (resp[2] << 8) | ((resp[3] >> 24) & 0xff);
+		cmd->response[3] = resp[3] << 8;
+	} else if (cmd->resp_type & MMC_RSP_PRESENT) {
+		cmd->response[0] = meson_sdio_read(priv, MESON_MX_SDIO_ARGU);
+	}
+}
+
+static int meson_mx_sdio_send_cmd(struct udevice *dev, struct mmc_cmd *cmd,
+				  struct mmc_data *data)
+{
+	struct meson_mx_sdio_priv *priv = dev_get_priv(dev);
+	struct mmc *mmc = mmc_get_mmc_dev(dev);
+	u32 send = 0, ext = 0, irqs;
+	ulong start;
+	uint len = 0;
+	int ret = 0;
+
+	if (data) {
+		if (!data->blocks || data->blocksize > 512 ||
+		    data->blocks > 256)
+			return -EINVAL;
+
+		len = data->blocks * data->blocksize;
+		if (!priv->bounce)
+			return -ENOMEM;
+
+		if (data->flags & MMC_DATA_WRITE) {
+			memcpy(priv->bounce, data->src, len);
+			flush_dcache_range((ulong)priv->bounce,
+					   (ulong)priv->bounce + len);
+		} else {
+			invalidate_dcache_range((ulong)priv->bounce,
+						(ulong)priv->bounce + len);
+		}
+
+		send |= FIELD_PREP(MESON_MX_SDIO_SEND_REPEAT_PACKAGE,
+				   data->blocks - 1);
+
+		ext = data->blocksize * 8;
+		if (mmc->bus_width == 4)
+			ext += MESON_MX_SDIO_RESPONSE_CRC16_BITS * 4;
+		else
+			ext += MESON_MX_SDIO_RESPONSE_CRC16_BITS;
+		ext = FIELD_PREP(MESON_MX_SDIO_EXT_DATA_RW_NUMBER, ext);
+
+		if (data->flags & MMC_DATA_WRITE)
+			send |= MESON_MX_SDIO_SEND_DATA;
+		else
+			send |= MESON_MX_SDIO_SEND_RESP_HAS_DATA;
+	}
+
+	switch (cmd->resp_type & ~MMC_RSP_BUSY) {
+	case MMC_RSP_R1:
+	case MMC_RSP_R3:
+		send |= FIELD_PREP(MESON_MX_SDIO_SEND_RESP_BITS, 45);
+		break;
+	case MMC_RSP_R2:
+		send |= FIELD_PREP(MESON_MX_SDIO_SEND_RESP_BITS, 133);
+		send |= MESON_MX_SDIO_SEND_RESP_CRC7_FROM_8;
+		break;
+	default:
+		break;
+	}
+
+	if (!(cmd->resp_type & MMC_RSP_CRC))
+		send |= MESON_MX_SDIO_SEND_RESP_WITHOUT_CRC7;
+
+	if (cmd->resp_type & MMC_RSP_BUSY)
+		send |= MESON_MX_SDIO_SEND_CHECK_DAT0_BUSY;
+
+	send |= FIELD_PREP(MESON_MX_SDIO_SEND_CMD_INDEX, 0x40 | cmd->cmdidx);
+
+	clrsetbits_le32((void __iomem *)(priv->base + MESON_MX_SDIO_MULT),
+			MESON_MX_SDIO_MULT_PORT_SEL,
+			priv->port & MESON_MX_SDIO_MULT_PORT_SEL);
+
+	setbits_le32((void __iomem *)(priv->base + MESON_MX_SDIO_IRQC),
+		     MESON_MX_SDIO_IRQC_CMD_INT_EN);
+
+	/* Clear any stale status bits. */
+	meson_sdio_write(priv, MESON_MX_SDIO_IRQS,
+			 MESON_MX_SDIO_IRQS_RESP_CRC7_OK |
+			 MESON_MX_SDIO_IRQS_READ_CRC16_OK |
+			 MESON_MX_SDIO_IRQS_WRITE_CRC16_OK |
+			 MESON_MX_SDIO_IRQS_IF_INT |
+			 MESON_MX_SDIO_IRQS_CMD_INT |
+			 MESON_MX_SDIO_IRQS_TIMING_OUT);
+
+	meson_sdio_write(priv, MESON_MX_SDIO_ARGU, cmd->cmdarg);
+	if (data) {
+		meson_sdio_write(priv, MESON_MX_SDIO_EXT, ext);
+		meson_sdio_write(priv, MESON_MX_SDIO_ADDR,
+				 (u32)(uintptr_t)priv->bounce);
+	} else {
+		meson_sdio_write(priv, MESON_MX_SDIO_EXT, 0);
+	}
+
+	meson_sdio_write(priv, MESON_MX_SDIO_SEND, send);
+
+	start = get_timer(0);
+	do {
+		irqs = meson_sdio_read(priv, MESON_MX_SDIO_IRQS);
+		if (irqs & MESON_MX_SDIO_IRQS_CMD_INT)
+			break;
+	} while (get_timer(start) < MESON_MX_SDIO_TIMEOUT_MS);
+
+	if (!(irqs & MESON_MX_SDIO_IRQS_CMD_INT)) {
+		ret = -ETIMEDOUT;
+	} else if (irqs & MESON_MX_SDIO_IRQS_TIMING_OUT) {
+		ret = -ETIMEDOUT;
+	} else if (data) {
+		if (!(irqs & (MESON_MX_SDIO_IRQS_READ_CRC16_OK |
+			      MESON_MX_SDIO_IRQS_WRITE_CRC16_OK)))
+			ret = -EILSEQ;
+	} else if (!(irqs & MESON_MX_SDIO_IRQS_RESP_CRC7_OK) &&
+		   !(send & MESON_MX_SDIO_SEND_RESP_WITHOUT_CRC7)) {
+		ret = -EILSEQ;
+	}
+
+	meson_mx_sdio_read_response(priv, cmd);
+	meson_sdio_write(priv, MESON_MX_SDIO_IRQS, irqs);
+
+	if (data && (data->flags & MMC_DATA_READ)) {
+		invalidate_dcache_range((ulong)priv->bounce,
+					(ulong)priv->bounce + len);
+		memcpy(data->dest, priv->bounce, len);
+	}
+
+	if (ret) {
+		meson_mx_sdio_reset(priv);
+		meson_mx_sdio_set_ios(dev);
+	}
+
+	return ret;
+}
+
+static int meson_mx_sdio_bind(struct udevice *dev)
+{
+	struct meson_mx_sdio_plat *plat = dev_get_plat(dev);
+
+	return mmc_bind(dev, &plat->mmc, &plat->cfg);
+}
+
+static int meson_mx_sdio_probe(struct udevice *dev)
+{
+	struct meson_mx_sdio_plat *plat = dev_get_plat(dev);
+	struct meson_mx_sdio_priv *priv = dev_get_priv(dev);
+	struct mmc_uclass_priv *upriv = dev_get_uclass_priv(dev);
+	struct mmc *mmc = &plat->mmc;
+	struct mmc_config *cfg = &plat->cfg;
+	fdt_addr_t addr;
+	u32 port;
+	int ret;
+
+	addr = dev_read_addr(dev);
+	if (addr == FDT_ADDR_T_NONE)
+		return -EINVAL;
+
+	priv->base = (u32)addr;
+	ret = dev_read_u32(dev, "port", &port);
+	if (ret)
+		port = 2;
+	priv->port = port & MESON_MX_SDIO_MULT_PORT_SEL;
+	priv->clk81_rate = meson_clk81_rate();
+	priv->bounce = memalign(ARCH_DMA_MINALIGN, 256 * 512);
+	if (!priv->bounce)
+		return -ENOMEM;
+
+	cfg->name = dev->name;
+	cfg->voltages = MMC_VDD_33_34;
+	cfg->host_caps = MMC_MODE_4BIT | MMC_MODE_HS;
+	cfg->f_min = 200000;
+	cfg->f_max = 50000000;
+	cfg->b_max = 256;
+	cfg->part_type = PART_TYPE_DOS;
+
+	mmc->priv = priv;
+	upriv->mmc = mmc;
+
+	meson_mx_sdio_reset(priv);
+
+	mmc->clock = cfg->f_min;
+	mmc->bus_width = 1;
+	meson_mx_sdio_set_ios(dev);
+
+	return 0;
+}
+
+static const struct dm_mmc_ops meson_mx_sdio_ops = {
+	.send_cmd = meson_mx_sdio_send_cmd,
+	.set_ios = meson_mx_sdio_set_ios,
+};
+
+static const struct udevice_id meson_mx_sdio_ids[] = {
+	{ .compatible = "amlogic,meson-mx-sdio" },
+	{ /* sentinel */ }
+};
+
+U_BOOT_DRIVER(meson_mx_sdio) = {
+	.name = "meson_mx_sdio",
+	.id = UCLASS_MMC,
+	.of_match = meson_mx_sdio_ids,
+	.ops = &meson_mx_sdio_ops,
+	.bind = meson_mx_sdio_bind,
+	.probe = meson_mx_sdio_probe,
+	.priv_auto = sizeof(struct meson_mx_sdio_priv),
+	.plat_auto = sizeof(struct meson_mx_sdio_plat),
+};
