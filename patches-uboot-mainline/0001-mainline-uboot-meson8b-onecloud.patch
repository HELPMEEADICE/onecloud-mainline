diff --git a/board/amlogic/onecloud/onecloud.c b/board/amlogic/onecloud/onecloud.c
new file mode 100644
index 00000000..230353c7
--- /dev/null
+++ b/board/amlogic/onecloud/onecloud.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Xunlei OneCloud (Amlogic S805 / Meson8b) board support.
+ *
+ * This port is intended to run as U-Boot proper, loaded by the Amlogic
+ * vendor SPL (the SPL and DDR training code are kept from the working
+ * Armbian/vendor bootloader).
+ */
+
+#include <init.h>
+#include <linux/bitops.h>
+#include <asm/io.h>
+#include <asm/global_data.h>
+#include <linux/delay.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define MESON_CBUS_BASE			0xc1100000
+
+#define WDT_TC				(MESON_CBUS_BASE + 0x9900)
+#define WDT_RESET			(MESON_CBUS_BASE + 0x9904)
+#define HHI_GCLK_MPEG0			(MESON_CBUS_BASE + 0x4140)
+#define PERIPHS_PIN_MUX_2		(MESON_CBUS_BASE + 0x80b8)
+#define PERIPHS_PIN_MUX_6		(MESON_CBUS_BASE + 0x80c8)
+#define DDR_SIZE_IND_ADDR		0xd9000000
+
+int board_early_init_f(void)
+{
+	/* The vendor SPL arms the watchdog for 5 seconds. */
+	writel(0, WDT_TC);
+	writel(0, WDT_RESET);
+
+	/*
+	 * Enable the gate for the SDIO/MMC controller.  The controller is
+	 * used for the eMMC (port C) and the SD card (port B) on this board.
+	 */
+	setbits_le32(HHI_GCLK_MPEG0, BIT(17));
+
+	/*
+	 * Route the eMMC pads (BOOT_0..BOOT_5) to the SDIO port C function.
+	 * This matches the pinmux used by the vendor U-Boot and by the
+	 * meson-mx-sdio driver in Linux.
+	 */
+	clrbits_le32(PERIPHS_PIN_MUX_2, 0x1f << 22);
+	setbits_le32(PERIPHS_PIN_MUX_6, 0x3f << 26);
+
+	/* Route the SD card pads (CARD_0..CARD_5) to SDIO port B. */
+	setbits_le32(PERIPHS_PIN_MUX_2, 0x3f << 10);
+
+	return 0;
+}
+
+int dram_init(void)
+{
+	u32 ddr_size = readl(DDR_SIZE_IND_ADDR);
+
+	if (ddr_size < 128 || ddr_size > 2048)
+		ddr_size = 1024;
+
+	gd->ram_size = (phys_size_t)ddr_size << 20;
+	gd->ram_base = 0;
+
+	return 0;
+}
+
+int board_init(void)
+{
+	/* The machine ID is not used; the device tree is embedded/appended. */
+	gd->bd->bi_boot_params = 0;
+
+	return 0;
+}
+
+int misc_init_r(void)
+{
+	/* A MAC address can be provided by the environment or DHCP. */
+	return 0;
+}
+
+void reset_cpu(ulong addr)
+{
+	/* Trigger a watchdog reset; this also works when the CPU hangs. */
+	writel(0, WDT_RESET);
+	writel(10 | BIT(19) | (0xf << 24), WDT_TC);
+
+	while (1)
+		;
+}
+
+int print_cpuinfo(void)
+{
+	printf("CPU: Amlogic S805 (Meson8b), 4x Cortex-A5\n");
+
+	return 0;
+}
