diff --git a/drivers/timer/meson6_timer.c b/drivers/timer/meson6_timer.c
new file mode 100644
index 00000000..0d22c11c
--- /dev/null
+++ b/drivers/timer/meson6_timer.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic Meson6/8/8b timer (timer E, 1 us free-running counter).
+ */
+
+#include <dm.h>
+#include <linux/bitops.h>
+#include <timer.h>
+#include <asm/io.h>
+
+#define MESON_TIMER_MUX			0x00
+#define MESON_TIMER_E			0x14
+#define MESON_TIMER_MUX_E_CLK_MASK	GENMASK(10, 8)
+#define MESON_TIMER_MUX_E_CLK_1US	1
+
+struct meson6_timer_priv {
+	void __iomem *base;
+};
+
+static u64 meson6_timer_get_count(struct udevice *dev)
+{
+	struct meson6_timer_priv *priv = dev_get_priv(dev);
+
+	return timer_conv_64(readl(priv->base + MESON_TIMER_E));
+}
+
+static int meson6_timer_probe(struct udevice *dev)
+{
+	struct timer_dev_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct meson6_timer_priv *priv = dev_get_priv(dev);
+	u32 val;
+
+	priv->base = (void __iomem *)dev_read_addr(dev);
+	if (!priv->base || priv->base == (void __iomem *)FDT_ADDR_T_NONE)
+		return -EINVAL;
+
+	val = readl(priv->base + MESON_TIMER_MUX);
+	val &= ~MESON_TIMER_MUX_E_CLK_MASK;
+	val |= MESON_TIMER_MUX_E_CLK_1US << 8;
+	writel(val, priv->base + MESON_TIMER_MUX);
+
+	uc_priv->clock_rate = 1000000;
+
+	return 0;
+}
+
+static const struct timer_ops meson6_timer_ops = {
+	.get_count = meson6_timer_get_count,
+};
+
+static const struct udevice_id meson6_timer_ids[] = {
+	{ .compatible = "amlogic,meson6-timer" },
+	{ /* sentinel */ }
+};
+
+U_BOOT_DRIVER(meson6_timer) = {
+	.name = "meson6_timer",
+	.id = UCLASS_TIMER,
+	.of_match = meson6_timer_ids,
+	.probe = meson6_timer_probe,
+	.ops = &meson6_timer_ops,
+	.priv_auto = sizeof(struct meson6_timer_priv),
+};
