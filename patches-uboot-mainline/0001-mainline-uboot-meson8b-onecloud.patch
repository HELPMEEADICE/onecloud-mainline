diff --git a/arch/arm/dts/meson8b-onecloud.dts b/arch/arm/dts/meson8b-onecloud.dts
new file mode 100644
index 00000000..ab1f2eb6
--- /dev/null
+++ b/arch/arm/dts/meson8b-onecloud.dts
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Xunlei OneCloud (Amlogic S805 / Meson8b) U-Boot device tree.
+ *
+ * This tree is intentionally minimal: U-Boot proper only needs the console,
+ * the timer and the SDIO/MMC controller used to load the kernel.  It does not
+ * reuse the Linux meson8b.dtsi because that tree pulls in the full clock and
+ * pinctrl providers, which are not implemented in this U-Boot port.
+ */
+
+/dts-v1/;
+
+/ {
+	model = "Xunlei OneCloud";
+	compatible = "xunlei,onecloud", "amlogic,meson8b";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &uart_AO;
+		mmc0 = &emmc;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory {
+		device_type = "memory";
+		reg = <0x00000000 0x40000000>;
+	};
+
+	xtal: xtal-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		bootph-all;
+	};
+
+	uart_AO: serial@4c0 {
+		compatible = "amlogic,meson-uart";
+		reg = <0xc81004c0 0x18>;
+		clocks = <&xtal>;
+		clock-names = "baud";
+		status = "okay";
+		bootph-all;
+	};
+
+	emmc: mmc@8c20 {
+		compatible = "amlogic,meson-mx-sdio";
+		reg = <0xc1108c20 0x20>;
+		port = <2>;
+		bus-width = <4>;
+		status = "okay";
+	};
+
+	timer@9940 {
+		compatible = "amlogic,meson6-timer";
+		reg = <0xc1109940 0x18>;
+		bootph-all;
+	};
+
+	wdt@9900 {
+		compatible = "amlogic,meson6-wdt";
+		reg = <0xc1109900 0x8>;
+	};
+};
diff --git a/arch/arm/lib/vectors.S b/arch/arm/lib/vectors.S
index cf3f6c3e..0dccce4b 100644
--- a/arch/arm/lib/vectors.S
+++ b/arch/arm/lib/vectors.S
@@ -120,6 +120,18 @@ _not_used:		.word not_used
 _irq:			.word irq
 _fiq:			.word fiq
 
+#if defined(CONFIG_MESON_M8B)
+	/*
+	 * The Amlogic vendor SPL for Meson8b checks for 0x12345678 at
+	 * offset 60 (the first padding word after the exception vectors)
+	 * before jumping to U-Boot proper.  Keep that magic in the pad
+	 * slot so a mainline U-Boot can be loaded by the unmodified
+	 * vendor SPL.
+	 */
+	.globl _aml_uboot_magic
+_aml_uboot_magic:	.word 0x12345678
+#endif
+
 	.balignl 16,0xdeadbeef
 #endif
 
